# LIS blob conditional-fetch cache (guardrail #1) — raw blob bytes + ETags,
# persisted across runs via the GitHub Actions cache, never committed.
.lis_blob_cache/

# Python
__pycache__/
*.pyc

# Claude Code — local/transient (launch.json is committed; the rest is not)
.claude/worktrees/
.claude/settings.local.json

# web (front end) local npm cache used in the sandbox
web/.npm-cache/

# root build shim output (Cloudflare Pages)
/dist

# Open States bulk session archives — ~500 MB of .zip, re-downloadable from the manifest.
# The MANIFEST is committed (url + sha256 per session) so the set is reproducible and verifiable;
# the payload is not, because a repo is the wrong home for half a gigabyte of regenerable input.
# Contrast tools/historical_cache/va/ (the LIS CSVs) which IS committed at 1.6 MB gzipped.
tools/historical_cache/openstates_va/*.zip
tools/historical_cache/openstates_va/extracted/

# Derived cache — rebuilt by tools/calibration/subjects.py --refresh, never a source of truth
.subjects_cache.pkl

# derived vote cache (255 MB, rebuilt by tools/calibration/votes.py --refresh)
tools/calibration/.votes_cache.pkl
