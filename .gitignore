# LIS blob conditional-fetch cache (guardrail #1) — raw blob bytes + ETags,
# persisted across runs via the GitHub Actions cache, never committed.
.lis_blob_cache/

# Python
__pycache__/
*.pyc

# Claude Code — local/transient (launch.json is committed; the rest is not)
.claude/worktrees/
.claude/settings.local.json

# web (front end) local npm cache used in the sandbox
web/.npm-cache/

# root build shim output (Cloudflare Pages)
/dist
